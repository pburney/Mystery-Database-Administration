# Mystery 6 Configuration

# Target database connection string
# MySQL:  mysql://user:password@host:3306/database_name
# SQLite: sqlite:///absolute/path/to/file.db
TARGET_DB=mysql://root:password@localhost:3306/myapp

# Path to Mystery's own SQLite config file (users, groups, permissions, table defs)
CONFIG_DB_PATH=./mystery.db

# Secret for signing session cookies (use a long random string in production)
SESSION_SECRET=change-me-to-something-long-and-random

# Port to listen on
PORT=3000
