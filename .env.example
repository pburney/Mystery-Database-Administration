# Mystery Configuration

# Target database connection string
# MySQL:  mysql://user:password@host:3306/database_name
# SQLite: sqlite:///absolute/path/to/file.db
# Remote: mysql://user:password@db.example.com:3306/myapp
# Tunnel: mysql://user:password@127.0.0.1:3307/myapp  (after: ssh -L 3307:localhost:3306 user@host)
TARGET_DB=mysql://root:password@localhost:3306/myapp

# Path to Mystery's own SQLite config file (users, groups, permissions, table defs)
CONFIG_DB_PATH=./mystery.db

# Secret for signing session cookies (use a long random string in production)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-something-long-and-random

# Port to listen on
PORT=3000

# Set to 'true' when running behind a TLS-terminating reverse proxy (Nginx, Caddy, etc.)
# This enables the 'secure' flag on session cookies and trusts X-Forwarded-* headers.
HTTPS=false

# Set to 'production' in deployed environments (changes Morgan log format)
NODE_ENV=development
